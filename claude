        e.request = fluxus.request or request

    elseif REEL_LOADED or (getgenv and getgenv().REEL_LOADED) then
        e.name    = "REEL"
        e.getui   = gethui
        e.request = http_request or request

    elseif Medium or (getgenv and getgenv().Medium) then
        e.name    = "Medium"
        e.getui   = gethui
        e.request = http_request or request

    elseif Solara or (getgenv and getgenv().Solara) then
        e.name    = "Solara"
        e.getui   = gethui
        e.request = http_request or request

    elseif Codex or (getgenv and getgenv().IS_CODEX) then
        e.name    = "Codex"
        e.getui   = gethui
        e.request = http_request or request

    elseif Electron or (getgenv and getgenv().Electron) then
        e.name    = "Electron"
        e.getui   = gethui
        e.request = http_request or request

    elseif Hydrogen or (getgenv and getgenv().Hydrogen) then
        e.name    = "Hydrogen"
        -- Hydrogen uses CoreGui parent instead of gethui
        e.getui   = function() return game:GetService("CoreGui") end
        e.request = http_request or request

    elseif Delta or (getgenv and getgenv().Delta) then
        e.name    = "Delta"
        e.getui   = gethui
        e.request = http_request or request

    else
        -- Unknown / future executor — safe fallback
        e.name    = "Unknown"
        e.getui   = (gethui and gethui) or function()
            return game:GetService("CoreGui")
        end
        e.request = http_request or request or function() end
    end

    -- Normalise gethui: some executors return a function, some the object
    if type(e.getui) == "function" then
        local ok, result = pcall(e.getui)
        e.gui_parent = ok and result or game:GetService("CoreGui")
    else
        e.gui_parent = e.getui
    end

    print("[HalloweenFarm] executor →", e.name)
    return e
end)()

