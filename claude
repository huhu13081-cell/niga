-- ░░ ANTI-DETECT UTILS ░░
local function Jitter(base)
    -- randomise wait so server-side loop-frequency checks see noise
    if SETTINGS.SafeMode then
        task.wait(base + math.random(0, 25) / 100)
    else
        task.wait(base)
    end
end

local function SafeTP(cf)
    if not Root then return end
    if SETTINGS.TeleportMethod == "Tween" then
        local t = TweenService:Create(
            Root,
            TweenInfo.new(0.1, Enum.EasingStyle.Linear),
            {CFrame = cf}
        )
        t:Play(); t.Completed:Wait()
    elseif SETTINGS.TeleportMethod == "Velocity" then
        Root.Velocity = Vector3.zero
        Root.CFrame   = cf
    else
        Root.CFrame = cf
    end
end

-- Wrap remote fires so naked calls don't hit anti-cheat monitors
local function SafeFire(remote, ...)
    if remote and remote:IsA("RemoteEvent") then
        pcall(remote.FireServer, remote, ...)
    end
end

local function SafeInvoke(remote, ...)
    if remote and remote:IsA("RemoteFunction") then
        local ok, res = pcall(remote.InvokeServer, remote, ...)
        if ok then return res end
    end
end

-- Speed with same-frame adjacent write to blur the property-write signature
local function SetSpeed(v)
    if Hum and Hum.Parent then
        Hum.WalkSpeed = v
        Hum.HipHeight = Hum.HipHeight -- adjacent write noise
    end
end

