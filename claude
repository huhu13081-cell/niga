-- Toggle factory
local toggleY = 72
local function MakeToggle(label, setting)
    local btn = Instance.new("TextButton", Main)
    btn.Size     = UDim2.new(0, 236, 0, 34)
    btn.Position = UDim2.new(0, 12, 0, toggleY)
    toggleY      = toggleY + 42

    local function Refresh()
        btn.BackgroundColor3 = SETTINGS[setting]
            and Color3.fromRGB(110, 0, 210)
            or  Color3.fromRGB(40, 25, 60)
        btn.Text = label .. "  [" .. (SETTINGS[setting] and "ON" or "OFF") .. "]"
    end

    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font       = Enum.Font.Gotham
    btn.TextSize   = 13
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
    Refresh()

    btn.MouseButton1Click:Connect(function()
        SETTINGS[setting] = not SETTINGS[setting]
        Refresh()
    end)
end

