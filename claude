-- ░░ SCANNERS ░░
local function FindNPC()
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") then
            for _, name in ipairs(Halloween.NPCs) do
                if model.Name:find(name) then
                    local r = model:FindFirstChild("HumanoidRootPart")
                    local h = model:FindFirstChildOfClass("Humanoid")
                    if r and h and h.Health > 0 then
                        return model, r
                    end
                end
            end
        end
    end
end

local function FindChest()
    for _, obj in ipairs(workspace:GetDescendants()) do
        for _, name in ipairs(Halloween.Items) do
            if obj.Name:find(name) then
                if obj:IsA("BasePart") then return obj end
                if obj:IsA("Model") then
                    return obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                end
            end
        end
    end
end

local function FindEventFruit()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:find(Halloween.Fruit) and obj:IsA("BasePart") then
            return obj
        end
    end
end

-- Remote resolver — Blox Fruits renames remotes per update
local RemoteCache = {}
local function GetRemote(path)
    if RemoteCache[path] then return RemoteCache[path] end
    local node = ReplicatedStorage
    for _, seg in ipairs(path:split("/")) do
        node = node:FindFirstChild(seg)
        if not node then return nil end
    end
    RemoteCache[path] = node
    return node
end

-- ░░ ATTACK HELPER ░░
local function AttackNPC(npcRoot)
    SafeTP(npcRoot.CFrame + npcRoot.CFrame.LookVector * -4)
    Jitter(0.05)

    local tool = Char:FindFirstChildOfClass("Tool")
    if tool then
        -- try remote first (fruit skills)
        local remote = tool:FindFirstChildOfClass("RemoteEvent")
            or tool:FindFirstChild("Activate")
        if remote and remote:IsA("RemoteEvent") then
            SafeFire(remote)
        else
            pcall(function() tool:Activate() end)
        end
    end

    -- fallback: Blox Fruits main attack remote (name varies per patch)
    local attackRemote = GetRemote("Remotes/Combat")
        or GetRemote("Remotes/Attack")
        or GetRemote("Remotes/Skill")
    if attackRemote then SafeFire(attackRemote, npcRoot.Parent) end
end

-- ░░ FRUIT SNIPE ░░
local function SnipeFruit()
    local fruit = FindEventFruit()
    if not fruit then return end
    SafeTP(fruit.CFrame + Vector3.new(0, 3, 0))
    Jitter(0.3)
    local eatRemote = GetRemote("Remotes/Eat_Fruit")
        or GetRemote("Remotes/EatFruit")
        or GetRemote("Remotes/Fruit/Eat")
    if eatRemote then SafeFire(eatRemote, fruit) end
end

-- ░░ MAIN LOOPS ░░
local function HalloweenLoop()
    while task.wait() do
        if not SETTINGS.AutoHalloween then Jitter(1) continue end

        local npc, npcRoot = FindNPC()
        if npc and npcRoot then
            AttackNPC(npcRoot)
            Jitter(SETTINGS.FarmDelay)
        else
            if SETTINGS.AutoCollect then
                local chest = FindChest()
                if chest then
                    SafeTP(chest.CFrame + Vector3.new(0, 2, 0))
                    Jitter(SETTINGS.ChestDelay)
                end
            end
            Jitter(1.2)
        end
    end
end

local function SnipeLoop()
    while task.wait(SETTINGS.SnipeInterval) do
        if SETTINGS.FruitSnipe then SnipeFruit() end
    end
end

local function SpeedLoop()
    RunService.Heartbeat:Connect(function()
        if SETTINGS.SpeedHack then SetSpeed(SETTINGS.SpeedValue) end
    end)
end

local function StartAntiAFK()
